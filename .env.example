# Express API configuration
PORT=3000

# Required for Prisma CLI and database migrations
# Replace placeholders with your local PostgreSQL credentials
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/supportdesk?schema=public"

# AI provider: mock is free and deterministic; remote providers are opt-in.
AI_PROVIDER=mock

# Set provider keys only in the backend environment; never put them in apps/web.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OPENAI_API_KEY is required only when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Configure both rates to log estimated cost; values are USD per 1 million tokens.
OPENAI_INPUT_USD_PER_MILLION_TOKENS=
OPENAI_OUTPUT_USD_PER_MILLION_TOKENS=
